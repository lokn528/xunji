# Agent folders may hold credentials, auth tokens, or other identifying artifacts.
# The Spec Kit skills themselves are plain Markdown and are tracked so the whole
# team shares one workflow definition; everything else in .agents/ is ignored.
.agents/*
!.agents/skills/
!.agents/skills/**

# Local editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
*.log

# Build output
dist/
build/
*.egg-info/
