# Agent folders may hold credentials, auth tokens, or other identifying artifacts.
# The Spec Kit skills themselves are plain Markdown and are tracked so the whole
# team shares one workflow definition; everything else in .agents/ is ignored.
.agents/*
!.agents/skills/
!.agents/skills/**

# Local editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
*.log

# Build output
dist/
build/
*.egg-info/
dist-ssr
*.local

# Rust / Tauri
src-tauri/target/
src-tauri/gen/schemas

# Local UI screenshots used for visual self-checks
.shots/

# Local planning notes and runtime data must never be published
.planning/
.env
.env.*
!.env.example
/xunji.db
/xunji.db-*
/library/
/thumbs/
